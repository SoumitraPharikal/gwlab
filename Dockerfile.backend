FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GWLAB_ENV=production \
    GWLAB_API_HOST=0.0.0.0 \
    GWLAB_API_PORT=8000 \
    GWLAB_DATA_ROOT=/data

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir ".[api]" \
    && useradd --create-home --shell /bin/bash gwlab

USER gwlab

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/status', timeout=3)"

CMD ["uvicorn", "gwlab.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
