# GWLab Runtime Configuration Template
# Copy to .env for local or Docker Compose overrides.

# Backend FastAPI settings
GWLAB_ENV=production
GWLAB_API_HOST=127.0.0.1
GWLAB_API_PORT=8000
# Optional override for read-only scientific artifacts root (defaults to repo root locally, /data in Docker)
# GWLAB_DATA_ROOT=/data
GWLAB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Next.js settings (NEXT_PUBLIC_API_URL is inlined at Next.js build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
GWLAB_FRONTEND_PORT=3000
